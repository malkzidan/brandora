# Placeholders only. No implicit .env loading; inject settings or use app.local --env-file.
APP_ENV=local
AI_PROVIDER=rules
AI_INTEGRATION_ENABLED=false
AI_SERVICE_TOKEN=
BACKEND_BASE_URL=
BACKEND_SERVICE_TOKEN=
# Public RSA verification PEM; literal \n newlines supported.
BACKEND_CONTEXT_PUBLIC_KEY=
BACKEND_TIMEOUT_SECONDS=5
INTEGRATION_TIMEOUT_SECONDS=25
TRUSTED_PROXY_CIDRS=
STOCK_QUANTITY_DISCLOSURE_BUSINESSES=
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b
GENERATOR_ENABLED=true
CHAT_PROVIDER_TIMEOUT_SECONDS=3
CHAT_TOTAL_TIMEOUT_SECONDS=8
CHAT_CIRCUIT_SECONDS=30
LOG_LEVEL=INFO
PORT=8080
# Release requires APP_ENV=staging/production, AI_PROVIDER=groq, canonical integration,
# distinct service secrets, Backend HTTPS origin/public key and verified trusted proxies.
# Fixed issuer/audience/scope are documented in docs/API_CONTRACT.md.
# Explicit loopback runner only:
AI_LOCAL_ENABLED=false
AI_LOCAL_PROVIDER=rules
AI_LOCAL_PORT=8000
